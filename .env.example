# ─── VIDKIDZ — Environment Variables ────────────────────────────────────────
# Salin file ini ke .env dan isi nilainya

# Server
PORT=3000
ALLOW_ADMIN_LOGIN=false
GOOGLE_CLIENT_ID=isi-google-oauth-client-id.apps.googleusercontent.com

# JWT Secret — ganti dengan string random panjang di production!
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ganti-dengan-string-random-panjang-dan-aman

# ─── 9Router (AI Gateway) Configuration ───────────────────────────────────────
AI_PROVIDER=9router
NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1
NINEROUTER_API_KEY=9r-xxxxxxxxxxxxxxxxxxxxx
AI_MODEL_SMART=openai/gpt-4o-mini
AI_MODEL_FAST=openai/gpt-4o-mini

# Anthropic API Key (opsional / legacy fallback)
# Dapatkan di: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# ─── Vrintex Image API Configuration ──────────────────────────────────────────
IMAGE_API_BASE_URL=https://image.vrintex.id/v1
IMAGE_API_KEY=***
IMAGE_MODEL=ag/gemini-3.1-flash-image
# Fallback LAN tanpa internet:
# IMAGE_API_BASE_URL=http://192.168.1.14:8092/v1

# ─── Image & Media Retention Policy ───────────────────────────────────────────
IMAGE_RETENTION_DAYS=7
